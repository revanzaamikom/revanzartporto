		.wp-pack {
			display: flex; flex-direction: column;
			border: 1px solid var(--wp-line); border-radius: 12px; background: var(--wp-bg1);
			padding: 32px 30px;
		}
		.wp-pack--featured { border-color: var(--wp-accent); background: var(--wp-bg2); }
		.wp-pack__head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
		.wp-pack__name { font-family: var(--wp-display); font-size: 1.6rem; font-weight: 700; color: var(--wp-text); }
		.wp-pack__tag { font-family: var(--wp-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--wp-accent); text-align: right; }
		.wp-pack__desc { color: var(--wp-mute); font-size: 0.92rem; line-height: 1.6; margin: 14px 0 0; }
		.wp-pack__list { list-style: none; margin: 22px 0 0; padding: 22px 0 0; border-top: 1px solid var(--wp-line); }
		.wp-pack__list li { position: relative; padding-left: 18px; color: var(--wp-text); font-size: 0.88rem; line-height: 1.5; margin-bottom: 9px; }
		.wp-pack__list li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 6px; height: 6px; background: var(--wp-accent); border-radius: 1px; }
		.wp-addons { margin-top: 22px; border: 1px solid var(--wp-line); border-radius: 12px; padding: 28px 30px; background: var(--wp-bg1); }

		/* ---------- Tentang ---------- */
		.wp-about { display: grid; grid-template-columns: 1fr; gap: 28px; }
		@media (min-width: 900px) { .wp-about { grid-template-columns: 0.34fr 0.66fr; align-items: start; } }
		.wp-about__body p { color: var(--wp-mute); font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.75; margin: 0 0 18px; max-width: 66ch; }
		.wp-about__facts { list-style: none; margin: 26px 0 0; padding: 24px 0 0; border-top: 1px solid var(--wp-line); display: grid; grid-template-columns: 1fr; gap: 12px; }
		@media (min-width: 640px) { .wp-about__facts { grid-template-columns: repeat(2, 1fr); } }
		@media (min-width: 1040px) { .wp-about__facts { grid-template-columns: repeat(4, 1fr); } }
		.wp-about__facts li { color: var(--wp-text); font-size: 0.92rem; }
		.wp-about__facts span { display: block; font-family: var(--wp-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--wp-accent); margin-bottom: 6px; }

		/* ---------- Tools & tech ---------- */
		.wp-tools { border: 1px solid var(--wp-line); border-radius: 6px; padding: 30px 28px; background: var(--wp-bg1); }
		.wp-tools__label { font-family: var(--wp-mono); font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--wp-mute); margin: 0 0 16px; }
		.wp-tools__row { display: flex; flex-wrap: wrap; gap: 8px; }
		.wp-tools__note { color: var(--wp-mute); font-size: 0.88rem; line-height: 1.65; margin: 20px 0 0; max-width: 60ch; }
		.wp-grid4 { display: grid; grid-template-columns: 1fr; gap: 18px; margin-top: 22px; }
		@media (min-width: 720px) { .wp-grid4 { grid-template-columns: repeat(2, 1fr); } }
		@media (min-width: 1040px) { .wp-grid4 { grid-template-columns: repeat(4, 1fr); } }
		.wp-group { border: 1px solid var(--wp-line); border-radius: 6px; padding: 22px 20px; }
		.wp-group__label { font-family: var(--wp-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--wp-accent); margin: 0 0 14px; }
		.wp-group__list { list-style: none; margin: 0; padding: 0; }
		.wp-group__list li { color: var(--wp-text); font-size: 0.9rem; padding: 5px 0; }
		.wp-group__list li + li { border-top: 1px solid var(--wp-line); }

		/* ---------- Contact ---------- */
		.wp-contact { text-align: center; display: flex; flex-direction: column; align-items: center; }

		/* ---------- Inquiry form (brief §11) ---------- */
		.wp-form {
			width: 100%; max-width: 760px; margin-top: 46px; text-align: left;
			border: 1px solid var(--wp-line); border-radius: 12px; background: var(--wp-bg1);
			padding: 32px 30px 28px;
		}
		.wp-form__title { font-family: var(--wp-display); font-size: 1.35rem; font-weight: 700; margin: 0; color: var(--wp-text); }
		.wp-form__note { color: var(--wp-mute); font-size: 0.9rem; line-height: 1.6; margin: 8px 0 0; }
		.wp-form__grid { display: grid; grid-template-columns: 1fr; gap: 16px; margin-top: 24px; }
		@media (min-width: 640px) { .wp-form__grid { grid-template-columns: 1fr 1fr; } .wp-field--full { grid-column: 1 / -1; } }
		.wp-field { display: flex; flex-direction: column; gap: 7px; }
		.wp-field__label { font-family: var(--wp-mono); font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--wp-mute); }
		.wp-field__label em { color: var(--wp-accent); font-style: normal; }
		.wp-field__input {
			font-family: var(--wp-mono); font-size: 1rem; color: var(--wp-text);
			background: var(--wp-bg0); border: 1px solid var(--wp-line); border-radius: 6px;
			padding: 12px 14px; width: 100%; box-sizing: border-box; transition: border-color .2s, box-shadow .2s;
		}
		/* iOS: font < 16px memicu auto-zoom saat fokus. Jaga >= 16px. */
		@media (max-width: 640px) { .wp-field__input { font-size: 16px; } }
		.wp-field__input::placeholder { color: #6b727a; }
		.wp-field__input:focus { outline: none; border-color: var(--wp-accent); box-shadow: 0 0 0 3px rgba(228,163,57,0.18); }
		.wp-field__input:invalid:not(:placeholder-shown) { border-color: #d9694a; }
		textarea.wp-field__input { resize: vertical; min-height: 84px; }
		.wp-form__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 24px; }
		.wp-form__foot .wp-btn { flex: 0 0 auto; }
		.wp-form__hint { display: inline-block; min-height: 1.1em; font-family: var(--wp-mono); font-size: 0.78rem; color: var(--wp-text); opacity: 0.85; }
		.wp-form__hint--err { color: #e08b6a; }
		.wp-form__fallback { color: var(--wp-mute); font-size: 0.82rem; margin: 18px 0 0; }
		/* Tap target email >= 44px (audit [1]) - naikkan tanpa mengubah tampilan teks */
		.wp-form__fallback a {
			display: inline-flex; align-items: center; min-height: 44px; padding-block: 10px;
			color: var(--wp-accent); text-decoration: none; word-break: break-all;
		}
		.wp-form__fallback a:hover { text-decoration: underline; }

		/* ---------- Reduced motion ---------- */
		@media (prefers-reduced-motion: reduce) {
			.wp-marquee__track { animation: none; }
			.wp-slide, .wp-btn, .wp-progress__fill { transition: none; }
			.wp-word > span, [data-fade] { opacity: 1 !important; transform: none !important; }
		}
		/* Mobile: pin dimatikan → slide jadi kolom normal */
		@media (max-width: 900px) {
			/* --- Padding section: ASIMETRIS (atas > bawah) supaya JUDUL section
			       punya udara dari section atas (judul tdk nempel). Bawah lebih
			       besar dari sebelumnya supaya ada jeda visual sebelum section
			       berikutnya + `.wp-bg` (sticky band) tidak menempel ke judul. --- */
			.wp-section { padding-top: clamp(96px, 13vw, 116px); padding-bottom: clamp(80px, 11vw, 104px); }

			/* Anchor scroll: navbar varian web `fixed top-5` (~66px). Beri ruang
			   supaya judul section tidak tertutup pill navbar saat lompat anchor. */
			#proyek, #layanan, #teknologi, #proses, #tentang, #paket, #kontak { scroll-margin-top: 84px; }

			/* Judul section di HP duduk di tepi atas `.wp-bg` (sticky band glow).
			   Beri headroom tambahan supaya judul turun ~24px menjauh dari tepi
			   gelap band -> tidak lagi terlihat "nempel/mepotong ke background". */
			.wp-head { margin-bottom: 22px; padding-top: 24px; }
			/* Judul yang tidak dibungkus `.wp-head` (mis. Tentang) tetap dapat jarak. */
			.wp-section > .wp-wrap > [data-split] { margin-top: 24px; }

			/* --- Pin track (Proyek): kolom normal, tanpa pin. --- */
			.wp-track-section { padding-top: clamp(96px, 13vw, 116px); padding-bottom: clamp(80px, 11vw, 104px); }
			.wp-track-section > .wp-track-pin > .wp-track-stage > .wp-track-head { padding-top: 24px; }
			.wp-track-stage { position: static; height: auto; padding: 0; }
			.wp-track-viewport { overflow: visible; }
			.wp-track { flex-direction: column; transform: none !important; gap: 18px; }

			/* --- FIX "card proyek terpotong + teks mepet":
			       max-height 100vh-220 + overflow hidden = aturan desktop (biar card
			       tak lebih tinggi dari viewport saat pin). Di mobile ini MEMOTONG isi.
			       Reset -> card memanjang sesuai isi, padding 26/28 berasa normal. --- */
			.wp-slide {
				flex: 1 1 auto; max-width: none; opacity: 1;
				max-height: none; overflow: visible;
				padding: 22px 20px 24px;
			}
			.wp-slide__body { overflow: visible; padding-right: 0; }
			.wp-slide__shot { margin: -22px -20px 18px; aspect-ratio: 16 / 10; }
			.wp-slide__shot img { position: static; height: auto; }

			/* --- FIX "judul -> card stack terlalu jauh / kurang padat":
			       .wp-stack-stage masih height:100vh + display:grid + align-items:center
			       (aturan desktop). Di mobile itu mendorong kartu ke tengah 844px ->
			       celah ~153px dari judul. Reset ke block + auto. --- */
			.wp-stack-stage {
				position: static; height: auto; min-height: 0;
				display: block; padding: 0;
			}
			.wp-stack-card { will-change: auto; }
			.wp-stack-card + .wp-stack-card { margin-top: 16px; }

			.wp-track-dots, .wp-track-hint { display: none; }
		}
	</style>
</Layout>
