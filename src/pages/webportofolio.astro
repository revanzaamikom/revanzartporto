---
import Layout from '../layouts/Layout.astro';

const services = [
	{
		n: '01', title: 'Landing Page',
		desc: 'Halaman fokus: memperkenalkan bisnis, menyampaikan nilai, dan mengarahkan pengunjung ke satu aksi yang jelas.',
		forWho: ['Usaha kecil', 'Personal brand', 'Promosi acara', 'Kampanye produk'],
		gives: ['Halaman responsif', 'Bagian hero & proposisi nilai', 'Info layanan / produk', 'CTA WhatsApp', 'Metadata SEO dasar'],
	},
	{
		n: '02', title: 'Website Bisnis',
		desc: 'Website multi-halaman yang menampilkan bisnis secara profesional dan membuat informasi penting mudah diakses pelanggan.',
		forWho: ['Jasa & layanan', 'Perusahaan lokal', 'Studio kreatif', 'Organisasi'],
		gives: ['Halaman beranda, tentang, layanan, kontak', 'Navigasi responsif', 'Form kontak / WhatsApp', 'Konfigurasi SEO dasar'],
	},
	{
		n: '03', title: 'Katalog Produk',
		desc: 'Katalog digital agar pelanggan bisa menelusuri produk dan kategori, lalu menghubungi bisnis lewat WhatsApp, bukan checkout.',
		forWho: ['Toko & retail', 'UMKM produk', 'Distributor', 'Konveksi & apparel'],
		gives: ['Katalog + filter kategori', 'Halaman detail produk', 'Galeri produk', 'Alur tanya via WhatsApp', 'Dashboard admin (opsional)'],
	},
	{
		n: '04', title: 'Aplikasi Web',
		desc: 'Aplikasi web interaktif untuk kebutuhan kerja tertentu: kalkulator, dashboard, atau alur bisnis yang khusus.',
		forWho: ['Alat internal', 'Perencanaan & budget', 'Data-driven', 'Discovery berbasis lokasi'],
		gives: ['Antarmuka interaktif', 'Alur kerja khusus', 'Validasi & penanganan error', 'Integrasi API sesuai kebutuhan'],
	},
	{
		n: '05', title: 'Perbaikan Website',
		desc: 'Merapikan website yang sudah ada: tampilan, kemudahan pakai, responsif, kecepatan, dan bug yang mengganggu.',
		forWho: ['Website lama', 'Tampilan berantakan', 'Tidak responsif', 'Sering error'],
		gives: ['Perbaikan layout responsif', 'Rapikan antarmuka & navigasi', 'Investigasi performa', 'Perbaikan bug', 'Update fitur yang ada'],
	},
];

// Case study NYATA, status jujur (anti-slop R-17/R-36/R-38)
// Urutan: Camp Plan dulu (proyek unggulan), lalu KonveksiKampus, PAKTJIP terakhir.
const projects = [
	{
		name: 'Camp Plan',
		kind: 'Aplikasi Web',
		meta: 'Next.js · Supabase · Peta',
		image: '/images/webportofolio/campplan.png',
		summary: 'Marketplace sewa alat outdoor: temukan vendor terdekat lewat peta, hitung biaya patungan per orang, lalu booking lewat WhatsApp.',
		points: [
			'Pencarian vendor berbasis lokasi (peta interaktif).',
			'Kalkulator biaya patungan per orang dengan validasi ketat.',
			'Alur kontak langsung ke vendor lewat WhatsApp.',
			'Autentikasi & data lewat Supabase; cache Upstash Redis.',
		],
		stack: ['Next.js 16', 'TypeScript', 'Supabase', 'Leaflet', 'Zod'],
		status: 'Demo publik sedang tidak aktif (kendala kredit hosting).',
	},
	{
		name: 'KonveksiKampus',
		kind: 'Katalog Produk',
		meta: 'MVP · Next.js · Static',
		image: '/images/webportofolio/konveksi.png',
		summary: 'Website katalog untuk vendor konveksi Yogyakarta (sejak 2012): unggulkan produk, jelaskan proses, arahkan ke konsultasi WhatsApp.',
		points: [
			'Arsitektur content-layer: data dipisah dari UI, siap naik ke database.',
			'Katalog per kategori dengan halaman detail dan CTA WhatsApp.',
			'Static export, cepat dan murah di-hosting.',
			'Preview klien otomatis live lewat GitHub Pages.',
		],
		stack: ['Next.js 16', 'TypeScript', 'Tailwind v4'],
		status: 'Tahap Standard (MVP). Preview klien berjalan; produksi menyusul.',
	},
	{
		name: 'PAKTJIP',
		kind: 'Website Bisnis + Admin Panel',
		meta: 'Klien nyata · PHP · MySQL',
		image: '/images/webportofolio/paktjip.png',
		summary: 'Etalase digital CV PakTjip Digital Printing, pengganti Linktree: katalog produk, kalkulator estimasi, admin panel untuk kelola konten sendiri.',
		points: [
			'Landing page 7 bagian yang menarik data dari database.',
			'Admin panel: CRUD produk, galeri, FAQ, dan pengaturan toko.',
			'Upload foto otomatis dikonversi ke WebP (GD), hemat kuota hosting.',
			'SEO lokal: JSON-LD LocalBusiness + sitemap.',
			'Setiap CTA mengarah ke WhatsApp dengan pesan terisi.',
		],
		stack: ['PHP 8', 'MySQL', 'PDO', 'GD', 'Vanilla JS'],
		status: 'Selesai dibangun; belum dipublikasikan sebagai situs produksi.',
	},
];

// Paket layanan sesuai brief §5 (isi fitur per tingkatan; harga final
// dibicarakan terpisah - jangan asumsikan harga per tipe; satu patokan
// "Mulai dari Rp500rb" ditaruh di judul section, bukan di tiap card).
const packages = [
	{
		name: 'Basic', tag: 'Kehadiran Digital',
		desc: 'Untuk usaha yang butuh kehadiran online sederhana tapi profesional.',
		items: ['Landing page satu halaman', 'Perkenalan bisnis', 'Ringkasan layanan / produk', 'Info kontak & CTA WhatsApp', 'Desain responsif', 'Metadata SEO dasar', 'Bantuan deploy'],
	},
	{
		name: 'Business', tag: 'Katalog Terkelola', featured: true,
		desc: 'Untuk usaha yang butuh katalog produk lebih terstruktur.',
		items: ['Fitur Basic', 'Struktur multi-halaman', 'Katalog produk + kategori', 'Dashboard admin', 'CRUD produk & kategori', 'Upload foto produk', 'Integrasi database'],
	},
	{
		name: 'Pro', tag: 'Manajemen Konten',
		desc: 'Untuk usaha yang butuh kontrol lebih atas konten website.',
		items: ['Fitur Business', 'Manajemen konten lebih luas', 'Bagian website yang bisa diedit', 'Struktur konten fleksibel', 'Integrasi tambahan', 'Dokumentasi serah terima'],
	},
];

const addons = ['Setup domain', 'Setup hosting & deploy', 'Halaman tambahan', 'Kategori produk tambahan', 'Migrasi konten', 'Maintenance website', 'Integrasi analytics', 'Integrasi form tambahan'];

const tools = ['Git / GitHub', 'Figma', 'XAMPP', 'Vercel / Netlify'];

const techGroups = [
	{ group: 'Frontend', items: ['Astro', 'React', 'Next.js', 'TypeScript', 'JavaScript'] },
	{ group: 'Styling & UI', items: ['Tailwind CSS', 'Figma'] },
	{ group: 'Backend & Data', items: ['PHP', 'MySQL', 'Supabase', 'Node.js'] },
	{ group: 'Deploy', items: ['Vercel', 'Netlify', 'Git / GitHub'] },
];

const workflow = [
	{ n: '01', title: 'Diskusi', desc: 'Memahami bisnis, target pengguna, tujuan, dan fitur yang dibutuhkan.', out: 'Brief & lingkup awal' },
	{ n: '02', title: 'Perencanaan', desc: 'Menyusun struktur halaman, alur pengguna, dan kebutuhan teknis.', out: 'Sitemap & daftar fitur' },
	{ n: '03', title: 'Desain', desc: 'Menentukan arah visual, hierarki, dan pola interaksi.', out: 'Arah desain / mockup' },
	{ n: '04', title: 'Pengembangan', desc: 'Membangun website dan fitur yang disepakati.', out: 'Build yang bisa dijalankan' },
	{ n: '05', title: 'Pengujian', desc: 'Memeriksa navigasi, responsif, form, dan fitur interaktif.', out: 'Release candidate teruji' },
	{ n: '06', title: 'Deploy & Serah Terima', desc: 'Menerbitkan website dan menyerahkan dokumentasi yang disepakati.', out: 'Website live + dokumentasi' },
];

const marqueeItems = ['opencode', 'Astro', 'React', 'Next.js', 'TypeScript', 'Tailwind CSS', 'PHP', 'MySQL', 'Supabase', 'Node.js', 'Vite', 'Figma'];
---

	<Layout
		title="Web Development | REVANZART"
		description="Revanza membangun website modern dan responsif: landing page, website bisnis, katalog produk, aplikasi web, dan perbaikan website. Proyek nyata, status jujur, kontak langsung via WhatsApp."
		canonicalPath="/webportofolio"
		ogImage="/images/webportofolio/campplan.png"
		ogImageAlt="Pratinjau proyek web development Revanza"
		navVariant="web"
	>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link
		rel="stylesheet"
		href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Archivo:wght@500;600;700;800&display=swap"
	/>

	<main class="wp-page">
		<!--
			CONTRACT - /webportofolio (impeccable surface round, seed d0700071)
			THESIS: bukti seorang web developer, bukan iklan jasa. Menolak susunan "hero + grid kartu seragam + statistik".
			OWN-WORLD: dark hangat (near-black #090a0d), aksen amber (#e4a339), hairline 1px, radius kecil, Archivo display + IBM Plex Mono data.
			STORY: pengunjung paham kemampuan, melihat bukti nyata, lalu menghubungi via WhatsApp.
			FIRST VIEWPORT: display besar + kolom figur kanan (counter), narasi kiri; CTA tunggal di bawah.
			FORM: Card Deck Proyek, diadaptasi jadi horizontal pin track (mekanik rafaelkurosawa, vanilla JS).
			FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance.
		-->

		{/* ---- overlay: progress + grain + cursor ---- */}
		<div class="wp-progress" aria-hidden="true"><span class="wp-progress__fill" data-progress></span></div>
		<div class="wp-grain" aria-hidden="true"></div>
		<div class="wp-cursor" data-cursor aria-hidden="true"></div>
		<div class="wp-cursor-ring" data-cursor-ring aria-hidden="true"></div>

		{/* ============ HERO ============ */}
		<section class="wp-hero" aria-labelledby="wp-title">
			<div class="wp-hero__bg" aria-hidden="true"><img src="/images/webportofolio/bg/hero-amber-glow.png" alt="" loading="eager" /></div>
			<div class="wp-wrap wp-hero__grid">
				<div class="wp-hero__lead">
					<p class="wp-eyebrow wp-fade" data-fade>Revanza, Web Development</p>
					<h1 id="wp-title" class="wp-display" data-split>Website dengan tujuan, bukan sekadar tampil.</h1>
					<p class="wp-lede wp-fade" data-fade>
						Saya membangun website modern dan responsif: membantu bisnis
						punya kehadiran online, menampilkan produk, dan terhubung
						dengan pelanggannya.
					</p>
					<div class="wp-actions wp-fade" data-fade>
						<a class="wp-btn wp-btn--solid" href="#kontak" data-magnetic>Mulai Proyek Website</a>
						<a class="wp-btn wp-btn--ghost" href="#proyek" data-magnetic>Lihat Proyek</a>
					</div>
				</div>

				<div class="wp-hero__index">
					<div class="wp-figure wp-fade" data-fade>
						<span class="wp-figure__num" data-value="3" data-pad="2">03</span>
						<span class="wp-figure__cap">Proyek nyata dibangun &amp; didokumentasikan</span>
					</div>
					<div class="wp-figure wp-fade" data-fade>
						<span class="wp-figure__num" data-value="5" data-pad="2">05</span>
						<span class="wp-figure__cap">Jenis website yang bisa dikerjakan</span>
					</div>
					<div class="wp-figure wp-fade" data-fade>
						<span class="wp-figure__num" data-value="1" data-pad="2">01</span>
						<span class="wp-figure__cap">Alat kerja utama: opencode</span>
					</div>
					<div class="wp-hero__list wp-fade" data-fade>
						<span class="wp-figure__cap">Yang saya kerjakan</span>
						<ul>
							<li>Landing page</li>
							<li>Website bisnis</li>
							<li>Katalog produk</li>
							<li>Aplikasi web</li>
							<li>Perbaikan website</li>
						</ul>
					</div>
				</div>
			</div>
		</section>

		{/* ============ PROYEK - HORIZONTAL PIN TRACK ============ */}
		<section id="proyek" class="wp-track-section" aria-labelledby="wp-proyek-title">
			<div class="wp-bg" aria-hidden="true"><img src="/images/webportofolio/bg/hero-amber-glow.png" alt="" loading="lazy" /></div>
			<div class="wp-track-pin" data-pin>
				<div class="wp-track-stage">
					<div class="wp-wrap wp-track-head">
						<h2 id="wp-proyek-title" class="wp-h2 wp-display--sm" data-split>Proyek</h2>
						<div class="wp-track-meta">
							<span class="wp-track-count" data-count>01<span> / 03</span></span>
							<span class="wp-track-hint" data-hint>scroll ↓</span>
						</div>
					</div>

					<div class="wp-track-viewport">
						<div class="wp-track" data-track>
							{projects.map((p, i) => (
								<article class="wp-slide" data-slide>
									<figure class="wp-slide__shot">
										<img src={p.image} alt={`Tampilan website ${p.name}`} loading="lazy" width="1440" height="900" />
									</figure>
									<div class="wp-slide__body">
										<header class="wp-slide__top">
											<span class="wp-slide__idx">{String(i + 1).padStart(2, '0')}</span>
											<span class="wp-slide__kind">{p.kind}</span>
										</header>
										<h3 class="wp-slide__name">{p.name}</h3>
										<p class="wp-slide__meta">{p.meta}</p>
										<p class="wp-slide__summary">{p.summary}</p>
										<ul class="wp-slide__points">
											{p.points.map((pt) => <li>{pt}</li>)}
										</ul>
										<div class="wp-slide__stack">
											{p.stack.map((s) => <span class="wp-chip">{s}</span>)}
										</div>
										<p class="wp-slide__status">{p.status}</p>
									</div>
								</article>
							))}
						</div>
					</div>

					<div class="wp-wrap wp-track-dots" data-dots aria-hidden="true">
						{projects.map(() => <i></i>)}
					</div>
				</div>
			</div>
		</section>

		{/* ============ LAYANAN - STICKY STACK ============ */}
		<section id="layanan" class="wp-section wp-section--stack" aria-labelledby="wp-layanan-title">
			<div class="wp-bg" aria-hidden="true"><img src="/images/webportofolio/bg/hero-amber-glow.png" alt="" loading="lazy" /></div>
			<div class="wp-wrap">
				<div class="wp-head">
					<h2 id="wp-layanan-title" class="wp-h2" data-split>Layanan</h2>
					<p class="wp-sub">Jenis website yang bisa saya kerjakan.</p>
				</div>
				<div class="wp-stack" data-stack>
					<div class="wp-stack-stage">
						{services.map((s) => (
							<article class="wp-stack-card" data-stack-card>
								<div class="wp-stack-card__inner">
									<span class="wp-stack-card__n">{s.n}</span>
									<div class="wp-stack-card__body">
										<h3 class="wp-stack-card__title">{s.title}</h3>
										<p class="wp-stack-card__desc">{s.desc}</p>
										<div class="wp-stack-card__cols">
											<div>
												<h4 class="wp-mini">Cocok untuk</h4>
												<ul class="wp-mini__list">
													{s.forWho.map((f) => <li>{f}</li>)}
												</ul>
											</div>
											<div>
												<h4 class="wp-mini">Yang didapat</h4>
												<ul class="wp-mini__list">
													{s.gives.map((g) => <li>{g}</li>)}
												</ul>
											</div>
										</div>
									</div>
								</div>
							</article>
						))}
					</div>
				</div>
			</div>
		</section>

		{/* ============ MARQUEE ============ */}
		<div class="wp-marquee" aria-hidden="true">
			<div class="wp-marquee__track">
				{[...marqueeItems, ...marqueeItems].map((m) => <span class="wp-marquee__item">{m}</span>)}
			</div>
		</div>

		{/* ============ TEKNOLOGI ============ */}
		<section id="teknologi" class="wp-section" aria-labelledby="wp-teknologi-title">
			<div class="wp-bg" aria-hidden="true"><img src="/images/webportofolio/bg/hero-amber-glow.png" alt="" loading="lazy" /></div>
			<div class="wp-wrap">
				<div class="wp-head">
					<h2 id="wp-teknologi-title" class="wp-h2" data-split>Teknologi</h2>
					<p class="wp-sub">Hanya yang benar-benar dipakai di proyek nyata.</p>
				</div>

				<div class="wp-tools wp-fade" data-fade>
					<h3 class="wp-tools__label">Tools I Use</h3>
					<div class="wp-tools__row">
						<span class="wp-chip wp-chip--accent">opencode <em>(AI coding agent)</em></span>
						{tools.map((t) => <span class="wp-chip">{t}</span>)}
					</div>
					<p class="wp-tools__note">
						Alur kerja modern: perencanaan &amp; dokumentasi terstruktur, version control,
						serta bantuan AI coding agent.
					</p>
				</div>

				<div class="wp-grid4">
					{techGroups.map((g) => (
						<div class="wp-group wp-fade" data-fade>
							<h3 class="wp-group__label">{g.group}</h3>
							<ul class="wp-group__list">
								{g.items.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					))}
				</div>
			</div>
		</section>

		{/* ============ PROSES - STICKY STACK ============ */}
		<section id="proses" class="wp-section wp-section--stack" aria-labelledby="wp-proses-title">
			<div class="wp-bg" aria-hidden="true"><img src="/images/webportofolio/bg/hero-amber-glow.png" alt="" loading="lazy" /></div>
			<div class="wp-wrap">
				<div class="wp-head">
					<h2 id="wp-proses-title" class="wp-h2" data-split>Proses Kerja</h2>
					<p class="wp-sub">Enam langkah dari ide sampai website terbit.</p>
				</div>
				<div class="wp-stack" data-stack>
					<div class="wp-stack-stage">
						{workflow.map((w) => (
							<article class="wp-stack-card" data-stack-card>
								<div class="wp-stack-card__inner">
									<span class="wp-stack-card__n">{w.n}</span>
									<div class="wp-stack-card__body">
										<h3 class="wp-stack-card__title">{w.title}</h3>
										<p class="wp-stack-card__desc">{w.desc}</p>
										<p class="wp-stack-card__out"><span>Hasil:</span> {w.out}</p>
									</div>
								</div>
							</article>
						))}
					</div>
				</div>
			</div>
		</section>

		{/* ============ TENTANG ============ */}
		<section id="tentang" class="wp-section" aria-labelledby="wp-tentang-title">
			<div class="wp-bg" aria-hidden="true"><img src="/images/webportofolio/bg/hero-amber-glow.png" alt="" loading="lazy" /></div>
			<div class="wp-wrap wp-about">
				<h2 id="wp-tentang-title" class="wp-h2" data-split>Tentang</h2>
				<div class="wp-about__body">
					<p>Kreator digital multidisiplin: menggabungkan pengembangan web dengan sisi visual, menekankan penyajian yang jelas, fungsi praktis, dan desain yang berpusat pada pengguna.</p>
					<p>Saya senang mengeksplorasi bagaimana produk digital menyelesaikan masalah nyata: dari website bisnis, katalog produk, sampai aplikasi web interaktif. Tiap proyek jadi cara memperdalam kemampuan teknis dan menajamkan pertimbangan desain.</p>
					<ul class="wp-about__facts">
						<li><span>Pendidikan</span> Teknologi Informasi, Universitas Amikom Yogyakarta</li>
						<li><span>Fokus</span> Website &amp; aplikasi web</li>
						<li><span>Pendekatan</span> Visual-first, praktis, siap berkembang</li>
						<li><span>Lokasi</span> Yogyakarta, Indonesia</li>
					</ul>
				</div>
			</div>
		</section>

		{/* ============ PAKET ============ */}
		<section id="paket" class="wp-section" aria-labelledby="wp-paket-title">
			<div class="wp-bg" aria-hidden="true"><img src="/images/webportofolio/bg/hero-amber-glow.png" alt="" loading="lazy" /></div>
			<div class="wp-wrap">
				<div class="wp-head wp-head--paket">
					<h2 id="wp-paket-title" class="wp-h2" data-split>Paket</h2>
					<span class="wp-price-badge">
						<span class="wp-price-badge__label">Mulai dari</span>
						<span class="wp-price-badge__amount">Rp500rb</span>
					</span>
					<p class="wp-sub">Tiga tingkatan layanan. Harga &amp; lingkup final dibicarakan terpisah sesuai kebutuhan.</p>
				</div>
				<div class="wp-packs">
					{packages.map((p) => (
						<article class:list={["wp-pack wp-fade", p.featured && "wp-pack--featured"]} data-fade>
							<header class="wp-pack__head">
								<span class="wp-pack__name">{p.name}</span>
								<span class="wp-pack__tag">{p.tag}</span>
							</header>
							<p class="wp-pack__desc">{p.desc}</p>
							<ul class="wp-pack__list">
								{p.items.map((it) => <li>{it}</li>)}
							</ul>
						</article>
					))}
				</div>
				<div class="wp-addons wp-fade" data-fade>
					<h3 class="wp-mini">Tambahan opsional</h3>
					<div class="wp-tools__row">
						{addons.map((a) => <span class="wp-chip">{a}</span>)}
					</div>
					<p class="wp-tools__note">Biaya berkala (domain, hosting, layanan pihak ketiga) dihitung terpisah dari biaya pengembangan.</p>
				</div>
			</div>
		</section>

		{/* ============ KONTAK ============ */}
		<section id="kontak" class="wp-section wp-section--contact" aria-labelledby="wp-kontak-title">
			<div class="wp-bg" aria-hidden="true"><img src="/images/webportofolio/bg/hero-amber-glow.png" alt="" loading="lazy" /></div>
			<div class="wp-wrap wp-contact">
				<h2 id="wp-kontak-title" class="wp-display wp-display--sm" data-split>Punya rencana website?</h2>
				<p class="wp-lede wp-lede--center wp-fade" data-fade>
					Mau landing page, website bisnis, katalog produk, atau aplikasi web,
					mari diskusikan kebutuhan Anda dan cari pendekatan yang paling pas.
				</p>
				<div class="wp-actions wp-actions--center wp-fade" data-fade>
