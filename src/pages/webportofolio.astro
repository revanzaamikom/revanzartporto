		.wp-price-badge__label { font-family: var(--wp-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--wp-mute); }
		.wp-price-badge__amount { font-family: var(--wp-display); font-size: 1.15rem; font-weight: 700; color: var(--wp-accent); letter-spacing: -0.01em; }
		@media (max-width: 560px) {
