		.wp-stack-card__n { font-family: var(--wp-mono); font-size: clamp(1.6rem, 3vw, 2.6rem); color: var(--wp-accent); line-height: 1; }
		.wp-stack-card__body { min-width: 0; }
		.wp-stack-card__title { font-family: var(--wp-display); font-size: clamp(1.5rem, 3.2vw, 2.4rem); font-weight: 700; letter-spacing: -0.02em; margin: 0; }
		.wp-stack-card__desc { color: var(--wp-mute); font-size: clamp(0.95rem, 1.3vw, 1.1rem); line-height: 1.7; margin: 14px 0 0; max-width: 62ch; }
		.wp-stack-card__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--wp-line); }
		.wp-stack-card__out { margin: 18px 0 0; color: var(--wp-text); font-size: 0.95rem; }
		.wp-stack-card__out span { font-family: var(--wp-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--wp-accent); margin-right: 8px; }
		.wp-mini { font-family: var(--wp-mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--wp-accent); margin: 0 0 12px; }
		.wp-mini__list { list-style: none; margin: 0; padding: 0; }
		.wp-mini__list li { position: relative; padding-left: 16px; color: var(--wp-text); font-size: 0.88rem; line-height: 1.5; margin-bottom: 7px; }
		.wp-mini__list li::before { content: ""; position: absolute; left: 0; top: 0.55em; width: 5px; height: 5px; background: var(--wp-accent); border-radius: 1px; }
		@media (max-width: 700px) {
			.wp-stack-card__cols { grid-template-columns: 1fr; gap: 18px; }
		}
		@media (max-width: 900px) {
			.wp-stack-stage { position: static; }
			.wp-stack-card__inner { grid-template-columns: 44px 1fr; padding: 24px 20px; min-height: 0; box-shadow: none; }
			.wp-stack-card__n { font-size: 1.1rem; }
