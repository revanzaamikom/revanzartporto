							<span class="mt-2 text-[11px] font-medium tracking-wide text-zinc-400 group-hover:text-white opacity-0 group-hover:opacity-100 transition-all duration-200 whitespace-nowrap">CorelDraw</span>
						</div>
						<div class="group relative flex flex-col items-center justify-end px-6 cursor-pointer transition-all duration-300">
							<img src="https://img.icons8.com/color/96/figma.png" alt="Figma" class="h-9 w-auto opacity-60 group-hover:opacity-100 transition-all duration-300 ease-out transform group-hover:-translate-y-1 group-hover:scale-125" />
							<span class="mt-2 text-[11px] font-medium tracking-wide text-zinc-400 group-hover:text-white opacity-0 group-hover:opacity-100 transition-all duration-200 whitespace-nowrap">Figma</span>
						</div>
						<div class="group relative flex flex-col items-center justify-end px-6 cursor-pointer transition-all duration-300">
							<img src="https://img.icons8.com/color/96/xampp.png" alt="XAMPP" class="h-9 w-auto opacity-60 group-hover:opacity-100 transition-all duration-300 ease-out transform group-hover:-translate-y-1 group-hover:scale-125" />
							<span class="mt-2 text-[11px] font-medium tracking-wide text-zinc-400 group-hover:text-white opacity-0 group-hover:opacity-100 transition-all duration-200 whitespace-nowrap">XAMPP</span>
						</div>
						<div class="group relative flex flex-col items-center justify-end px-6 cursor-pointer transition-all duration-300">
							<img src="https://img.icons8.com/ios-filled/96/ffffff/document.png" alt="Celtx" class="h-9 w-auto opacity-60 group-hover:opacity-100 transition-all duration-300 ease-out transform group-hover:-translate-y-1 group-hover:scale-125" />
							<span class="mt-2 text-[11px] font-medium tracking-wide text-zinc-400 group-hover:text-white opacity-0 group-hover:opacity-100 transition-all duration-200 whitespace-nowrap">Celtx</span>
						</div>
						<div class="group relative flex flex-col items-center justify-end px-6 cursor-pointer transition-all duration-300">
							<img src="https://img.icons8.com/color/96/blender-3d.png" alt="Blender" class="h-9 w-auto opacity-60 group-hover:opacity-100 transition-all duration-300 ease-out transform group-hover:-translate-y-1 group-hover:scale-125" />
							<span class="mt-2 text-[11px] font-medium tracking-wide text-zinc-400 group-hover:text-white opacity-0 group-hover:opacity-100 transition-all duration-200 whitespace-nowrap">Blender</span>
						</div>
						<div class="group relative flex flex-col items-center justify-end px-6 cursor-pointer transition-all duration-300">
							<img src="https://img.icons8.com/color/96/obs-studio.png" alt="OBS Studio" class="h-9 w-auto opacity-60 group-hover:opacity-100 transition-all duration-300 ease-out transform group-hover:-translate-y-1 group-hover:scale-125" />
							<span class="mt-2 text-[11px] font-medium tracking-wide text-zinc-400 group-hover:text-white opacity-0 group-hover:opacity-100 transition-all duration-200 whitespace-nowrap">OBS Studio</span>
						</div>
						<div class="group relative flex flex-col items-center justify-end px-6 cursor-pointer transition-all duration-300">
							<img src="https://img.icons8.com/ios-filled/96/ffffff/video-camera.png" alt="vMix" class="h-9 w-auto opacity-60 group-hover:opacity-100 transition-all duration-300 ease-out transform group-hover:-translate-y-1 group-hover:scale-125" />
							<span class="mt-2 text-[11px] font-medium tracking-wide text-zinc-400 group-hover:text-white opacity-0 group-hover:opacity-100 transition-all duration-200 whitespace-nowrap">vMix</span>
						</div>
						<div class="group relative flex flex-col items-center justify-end px-6 cursor-pointer transition-all duration-300">
							<img src="https://img.icons8.com/color/96/canva.png" alt="Canva" class="h-9 w-auto opacity-60 group-hover:opacity-100 transition-all duration-300 ease-out transform group-hover:-translate-y-1 group-hover:scale-125" />
							<span class="mt-2 text-[11px] font-medium tracking-wide text-zinc-400 group-hover:text-white opacity-0 group-hover:opacity-100 transition-all duration-200 whitespace-nowrap">Canva</span>
						</div>
						<!-- duplicate set for seamless loop -->
						<div class="group relative flex flex-col items-center justify-end px-6 cursor-pointer transition-all duration-300">
							<img src="https://img.icons8.com/color/96/adobe-after-effects.png" alt="After Effects" class="h-9 w-auto opacity-60 group-hover:opacity-100 transition-all duration-300 ease-out transform group-hover:-translate-y-1 group-hover:scale-125" />
							<span class="mt-2 text-[11px] font-medium tracking-wide text-zinc-400 group-hover:text-white opacity-0 group-hover:opacity-100 transition-all duration-200 whitespace-nowrap">After Effects</span>
						</div>
						<div class="group relative flex flex-col items-center justify-end px-6 cursor-pointer transition-all duration-300">
							<img src="https://img.icons8.com/color/96/adobe-premiere-pro.png" alt="Premiere Pro" class="h-9 w-auto opacity-60 group-hover:opacity-100 transition-all duration-300 ease-out transform group-hover:-translate-y-1 group-hover:scale-125" />
							<span class="mt-2 text-[11px] font-medium tracking-wide text-zinc-400 group-hover:text-white opacity-0 group-hover:opacity-100 transition-all duration-200 whitespace-nowrap">Premiere Pro</span>
						</div>
						<div class="group relative flex flex-col items-center justify-end px-6 cursor-pointer transition-all duration-300">
							<img src="https://img.icons8.com/color/96/adobe-illustrator.png" alt="Illustrator" class="h-9 w-auto opacity-60 group-hover:opacity-100 transition-all duration-300 ease-out transform group-hover:-translate-y-1 group-hover:scale-125" />
							<span class="mt-2 text-[11px] font-medium tracking-wide text-zinc-400 group-hover:text-white opacity-0 group-hover:opacity-100 transition-all duration-200 whitespace-nowrap">Illustrator</span>
						</div>
						</div>
					</div>
				<style>
					#software-skills .marquee-mask { overflow: hidden; }
					#software-skills .marquee-track { display:flex; gap:1.5rem; align-items:center; white-space:nowrap; animation: marquee-logos 32s linear infinite; }
					#software-skills .marquee-track { will-change: transform; }
					#software-skills .marquee-track img { display:inline-block; }
					@keyframes marquee-logos { from { transform: translateX(0%); } to { transform: translateX(-50%); } }
					#software-skills .marquee-mask { -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%); mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%); }
					#software-skills .marquee-mask:hover .marquee-track { animation-play-state: paused; }
				</style><!-- PAGE 4: Graphic Library -->
			<section id="graphic-library" class="pt-24 pb-16 max-w-7xl mx-auto px-6 md:px-24">
				<div class="mb-8">
					<h2 class="text-2xl font-extrabold">Graphic Library</h2>
					<p class="text-textMuted mt-2">Soft skills & selected graphic pieces. Klik gambar untuk pratinjau.</p>
				</div>
	n			<!-- Soft Skills Grid -->
				<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
					<div class="p-4 bg-zinc-900/60 rounded-xl text-center">Creative Direction</div>
					<div class="p-4 bg-zinc-900/60 rounded-xl text-center">Visual Storytelling</div>
					<div class="p-4 bg-zinc-900/60 rounded-xl text-center">Team Leadership</div>
					<div class="p-4 bg-zinc-900/60 rounded-xl text-center">Problem Solving</div>
				</div>

				<!-- Bento Grid Graphic Design (3 columns) -->
				<div class="mb-6">
					<h3 class="text-lg font-bold mb-3">Selected Graphics</h3>			</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
					<!-- Card 1 -->
					<div class="rounded-2xl overflow-hidden bg-black/40 border border-white/10 cursor-pointer">
						<div class="aspect-[4/3] w-full h-auto">
							<img data-lightbox data-full="/images/graphic-1.jpg" src="/images/graphic-1-thumb.jpg" alt="Graphic 1" class="object-cover w-full h-full" />
						</div>
						<div class="p-3 text-sm text-textMuted">Project: Branding â€¢ Tools: Illustrator</div>
					</div>
					<!-- Card 2 -->
					<div class="rounded-2xl overflow-hidden bg-black/40 border border-white/10 cursor-pointer">
						<div class="aspect-[4/3] w-full h-auto">
							<img data-lightbox data-full="/images/graphic-2.jpg" src="/images/graphic-2-thumb.jpg" alt="Graphic 2" class="object-cover w-full h-full" />
						</div>
						<div class="p-3 text-sm text-textMuted">Project: Poster â€¢ Tools: Photoshop</div>
					</div>
					<!-- Card 3 -->
					<div class="rounded-2xl overflow-hidden bg-black/40 border border-white/10 cursor-pointer">
						<div class="aspect-[4/3] w-full h-auto">
							<img data-lightbox data-full="/images/graphic-3.jpg" src="/images/graphic-3-thumb.jpg" alt="Graphic 3" class="object-cover w-full h-full" />
						</div>
						<div class="p-3 text-sm text-textMuted">Project: Illustration â€¢ Tools: Procreate</div>
					</div>
				</div>
			</section>

			<!-- PAGE 5: Certificates -->
			<section id="certificates" class="pt-12 pb-24 max-w-7xl mx-auto px-6 md:px-24">
				<div class="mb-6">
					<h2 class="text-2xl font-extrabold">Certificates</h2>
					<p class="text-textMuted mt-2">Vault of e-certificates and achievements.</p>
				</div>

				<button id="open-cert-vault" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-cyan-500 text-black font-semibold">Buka Vault E-Certificate</button>

				<!-- Fullscreen Modal (hidden by default) -->
				<div id="cert-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 py-8 px-6">
					<div class="bg-zinc-950 w-full max-w-5xl mx-auto rounded-xl overflow-hidden shadow-2xl relative">
						<button id="close-cert-modal" class="absolute top-4 right-4 z-40 bg-white/10 hover:bg-white/20 px-3 py-1 rounded">Close</button>
						<div class="p-6">
							<h3 class="text-lg font-bold mb-4">E-Certificates Vault</h3>
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[70vh] overflow-auto">
								<!-- Certificate item 1 -->
								<div class="rounded-lg bg-black/40 p-3 flex gap-3 items-start">
									<img src="/images/cert-1-thumb.jpg" alt="Cert 1" class="w-32 h-20 object-cover rounded-md" />
									<div>
										<div class="font-medium">Workshop VFX 2025</div>
										<div class="text-xs text-textMuted">Issuer: VFX Academy</div>
									</div>
								</div>
								<!-- Certificate item 2 -->
								<div class="rounded-lg bg-black/40 p-3 flex gap-3 items-start">
									<img src="/images/cert-2-thumb.jpg" alt="Cert 2" class="w-32 h-20 object-cover rounded-md" />
									<div>
										<div class="font-medium">UI Design Bootcamp</div>
										<div class="text-xs text-textMuted">Issuer: Design Institute</div>
									</div>
								</div>
								<!-- Add more certificate frames as needed -->
							</div>
						</div>
					</div>
				</div>
			</section>
			<!-- Isolated script for lightbox and cert modal (keeps scope local, non-intrusive) -->
			<script>
			(function(){
				// Utility: create lightbox element once
				let lightboxEl = null;
				function createLightbox(){
					if (lightboxEl) return lightboxEl;
					lightboxEl = document.createElement('div');
					lightboxEl.id = 'lightbox-modal';
					lightboxEl.className = 'fixed inset-0 z-[60] hidden items-center justify-center bg-black/80 p-6';
					lightboxEl.innerHTML = '<div class="max-w-[90vw] max-h-[90vh] overflow-auto rounded">'<
						+ '<img id="lightbox-img" src="" alt="Preview" class="object-contain w-full h-auto rounded" />'
						+ '<button id="lightbox-close" class="absolute top-6 right-6 bg-white/10 hover:bg-white/20 px-3 py-1 rounded">Close</button>';
					document.body.appendChild(lightboxEl);
					return lightboxEl;
				}
				function openLightbox(src){
					createLightbox();
					const el = document.getElementById('lightbox-modal');
					if (!el) return;				const img = document.getElementById('lightbox-img');
					img.src = src;				el.classList.remove('hidden');				el.classList.add('flex');			}
				function closeLightbox(){				const el = document.getElementById('lightbox-modal');				if (!el) return;				sel.classList.remove('flex');				el.classList.add('hidden');				const img = document.getElementById('lightbox-img');				if (img) img.src = '';			}
				// Certificate modal handlers			function openCertModal(){				const m = document.getElementById('cert-modal');				if (!m) return; m.classList.remove('hidden'); m.classList.add('flex');			}
				function closeCertModal(){				const m = document.getElementById('cert-modal');				if (!m) return; m.classList.remove('flex'); m.classList.add('hidden');			}
				// Global event listeners (scoped, non-destructive)			document.addEventListener('click', function(e){				const lb = e.target.closest('[data-lightbox]');				if (lb){					e.preventDefault();					const src = lb.dataset.full || lb.src || lb.getAttribute('src');					if (src) openLightbox(src);					return;				}				if (e.target && e.target.id === 'lightbox-close') { closeLightbox(); return; }				if (e.target && e.target.id === 'open-cert-vault'){ e.preventDefault(); openCertModal(); return; }				if (e.target && e.target.id === 'close-cert-modal') { e.preventDefault(); closeCertModal(); return; }				// click on backdrop to close modal if clicked directly on overlay				if (e.target && e.target.id === 'cert-modal') { closeCertModal(); }			});
				document.addEventListener('keydown', function(e){				if (e.key === 'Escape') { closeLightbox(); closeCertModal(); }			});
			})();
			</script>
	</main>
</Layout>


