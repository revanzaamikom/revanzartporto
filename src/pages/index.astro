---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import WhatIDo from '../components/WhatIDo.astro';
import SplashScreen from '../components/SplashScreen.jsx';
---

<Layout title="Revanza Rafif | VFX & UI/UX Designer">
	<SplashScreen client:only="react" onComplete={() => {
		const event = new CustomEvent('splash-complete');
		window.dispatchEvent(event);
	}} />
	<main>
		<Hero />
		<ProjectGrid />
		<WhatIDo />

							<section id="software-skills" class="py-10 bg-black/80 border-y border-white/5 overflow-hidden relative">
			<div class="max-w-7xl mx-auto px-6 md:px-24">
				<div class="mb-4">
					<h3 class="text-sm text-textMuted uppercase tracking-widest">Software & Tools</h3>
				</div>
				<div class="marquee-mask relative overflow-hidden py-10">
					<div class="marquee-track flex items-center gap-6 overflow-visible" style="animation: marquee-logos 32s linear infinite; will-change: transform;">
