					</div>
					<div class="text-sm text-textMuted mt-2">Untitled</div>
</div>
									</div>

									<div data-category-panel="talking-head" class="hidden grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
<div class="rounded-lg bg-zinc-900/60 p-2 cursor-pointer" data-video-src="/videos/talkinghead-1.mp4">
					<img src="/images/talking-1-thumb.jpg" class="w-full h-28 object-cover rounded" alt="Talking Head 1" />
