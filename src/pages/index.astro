							<div class="font-medium">General Editing</div>
									<div class="text-xs text-textMuted mt-1">(View)</div>
						</button>
								<button type="button" class="category-card min-w-[200px] flex-none rounded-lg p-4 bg-zinc-900/60 text-textMuted hover:text-white hover:bg-zinc-800 transition-colors duration-200 border border-transparent hover:border-white/10 shadow-sm" data-category="talking-head">
							<div class="font-medium">Talking Head</div>
									<div class="text-xs text-textMuted mt-1">(View)</div>
						</button>
								<button type="button" class="category-card min-w-[200px] flex-none rounded-lg p-4 bg-zinc-900/60 text-textMuted hover:text-white hover:bg-zinc-800 transition-colors duration-200 border border-transparent hover:border-white/10 shadow-sm" data-category="property">
							<div class="font-medium">Property</div>
