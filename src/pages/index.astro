				document.body.appendChild(magModalEl);

				// Close handlers
				const closeBtn = magModalEl.querySelector('#mag-lightbox-close');
				closeBtn?.addEventListener('click', closeMagModal);
				magModalEl.addEventListener('click', (e) => {
					if (e.target === magModalEl) closeMagModal();
				});

				return magModalEl;
			}

			function openMagModal(url) {
				const modal = ensureMagModal();
				const container = modal.querySelector('#mag-iframe-container');
				if (container) {
					container.innerHTML = `
						<iframe src="${url}" class="w-full h-full border-0" allow="fullscreen" allowfullscreen></iframe>
					`;
				}
				modal.classList.remove('hidden');
				modal.classList.add('flex');
			}

			function closeMagModal() {
				const modal = document.getElementById('mag-lightbox-modal');
				if (!modal) return;
				const container = modal.querySelector('#mag-iframe-container');
				if (container) container.innerHTML = ''; // Destroy iframe immediately to release RAM
				modal.classList.add('hidden');
				modal.classList.remove('flex');
			}

			// Global event listeners (scoped, non-destructive)
			document.addEventListener('click', function(e){
				const lb = e.target.closest('[data-lightbox]');
				if (lb){
					e.preventDefault();
					const src = lb.dataset.lightbox || lb.dataset.full || lb.src || lb.getAttribute('src');
					if (src) openLightbox(src);
					return;
				}
				const magBtn = e.target.closest('[data-open-magazine]');
				if (magBtn) {
					e.preventDefault();
					const url = magBtn.getAttribute('data-open-magazine');
					if (url) openMagModal(url);
					return;
				}
				if (e.target && e.target.id === 'lightbox-close') { closeLightbox(); return; }
				if (e.target && e.target.id === 'open-cert-vault'){ e.preventDefault(); openCertModal(); return; }
				if (e.target && e.target.id === 'close-cert-modal') { e.preventDefault(); closeCertModal(); return; }
				// click on backdrop to close modal if clicked directly on overlay
				if (e.target && e.target.id === 'cert-modal') { closeCertModal(); }
			});
	
			document.addEventListener('keydown', function(e){
				if (e.key === 'Escape') { closeLightbox(); closeCertModal(); closeMagModal(); }
			});
	
		})();
			</script>
	</main>
</Layout>
