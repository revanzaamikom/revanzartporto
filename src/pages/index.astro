---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import WhatIDo from '../components/WhatIDo.astro';
import SplashScreen from '../components/SplashScreen.jsx';
---

<Layout title="Revanza Rafif | VFX & UI/UX Designer">
	<SplashScreen client:only="react" onComplete={() => {
		const event = new CustomEvent('splash-complete');
		window.dispatchEvent(event);
	}} />
	<main>
		<Hero />
		<ProjectGrid />
		<WhatIDo />

							<section id="software-skills" class="py-10 bg-black/80 border-y border-white/5 overflow-hidden relative">
			<div class="max-w-7xl mx-auto px-6 md:px-24">
				<div class="mb-4">
