							<div id="category-expanded" class="overflow-hidden max-h-0 transition-[max-height] duration-500">
								<div class="p-4">
									<div data-category-panel="short-movie" class="hidden grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
<div class="rounded-lg p-0 cursor-pointer overflow-hidden" data-video-src="https://www.youtube.com/embed/lsFE3Kv7wmw" data-preview-src="https://www.youtube.com/embed/lsFE3Kv7wmw?autoplay=1&mute=1&controls=0&loop=1&playlist=lsFE3Kv7wmw&modestbranding=1">
