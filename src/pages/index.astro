					<script>
					(function(){
// Category accordion behavior
const categoryBar = document.getElementById('category-bar');
const expanded = document.getElementById('category-expanded');
const panels = document.querySelectorAll('[data-category-panel]');

function collapseExpanded(){
	expanded.style.maxHeight = '0px';
	panels.forEach(p => p.classList.add('hidden'));
	document.querySelectorAll('.category-card.active').forEach(b => b.classList.remove('active','bg-zinc-800','text-white'));
}

						if (categoryBar){
	categoryBar.addEventListener('click', function(e){
		const btn = e.target.closest('[data-category]');
		if (!btn) return;
		const cat = btn.getAttribute('data-category');
		const panel = document.querySelector('[data-category-panel="'+cat+'"]');
		if (!panel) return;
		const isActive = btn.classList.contains('active');
		if (isActive){
									// toggle collapse
			collapseExpanded();
			return;
		}
		// activate selected card
		document.querySelectorAll('.category-card').forEach(b => b.classList.remove('active','bg-zinc-800','text-white'));
		btn.classList.add('active','bg-zinc-800','text-white');
		// show corresponding panel
		panels.forEach(p => p.classList.add('hidden'));
		panel.classList.remove('hidden');
		// compute and set smooth max-height
		const desired = panel.scrollHeight + 32; // add buffer for padding
		expanded.style.maxHeight = desired + 'px';
		// ensure expanded is visible on small screens — scroll to center to avoid overscrolling past the panel
		try { expanded.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch(e) { /* fallback */ expanded.scrollIntoView({ behavior: 'smooth' }); }
	});
}

						// Delegate clicks for video thumbnails (open modal) and load-into-player triggers
document.addEventListener('click', function(e){
							const thumb = e.target.closest('[data-video-src]');
	if (thumb){
								e.preventDefault();
								openGalleryVideoModal(thumb.getAttribute('data-video-src'));
								return;
							}
	const load = e.target.closest('[data-load-video]');
	if (load){
								e.preventDefault();
								const src = load.getAttribute('data-load-video');
								const vid = document.querySelector('#company-player');
								if (vid && src){
									vid.pause(); const source = vid.querySelector('source'); if (source) source.src = src; else { const s = document.createElement('source'); s.src = src; s.type = 'video/mp4'; vid.appendChild(s); } vid.load(); vid.play().catch(()=>{});
		}
							}
	// close modal button handled below (id=gallery-video-close)
	if (e.target && e.target.id === 'gallery-video-close'){
								e.preventDefault();
								const modal = document.getElementById('gallery-video-modal');
								if (!modal) return; const container = document.getElementById('gallery-video-container'); if (container) container.innerHTML = ''; modal.classList.remove('flex'); modal.classList.add('hidden');
							}
});

						// Modal helper: supports mp4 (video) or embed (YouTube/Vimeo iframe)
let galleryModal = null;
function ensureGalleryModal(){
							if (galleryModal) return galleryModal;
							galleryModal = document.createElement('div');
	galleryModal.id = 'gallery-video-modal';
	galleryModal.className = 'fixed inset-0 z-[90] hidden items-center justify-center bg-black/60 backdrop-blur-sm';
	galleryModal.innerHTML = '\n\t\t<div class="w-full h-full flex items-center justify-center p-6">' + '<div class="w-full h-full max-w-[1200px] max-h-[90vh] bg-black rounded-xl overflow-hidden relative">' + '<button id="gallery-video-close" aria-label="Close video" class="absolute top-4 right-4 z-50 bg-white/10 hover:bg-white/20 text-sm px-3 py-1 rounded-full">✕</button>' + '<div id="gallery-video-container" class="w-full h-full flex items-center justify-center bg-black"></div>' + '</div>' + '</div>\n';
	document.body.appendChild(galleryModal);
	// Close when clicking outside the content area (overlay)
	galleryModal.addEventListener('click', function(e){
		if (e.target && e.target.id === 'gallery-video-modal'){
			const container = document.getElementById('gallery-video-container'); if (container) container.innerHTML = ''; galleryModal.classList.add('hidden'); galleryModal.classList.remove('flex');
		}
	});
	// ESC to close
	document.addEventListener('keydown', function onEsc(e){ if (e.key === 'Escape'){ const m = document.getElementById('gallery-video-modal'); if (m && !m.classList.contains('hidden')){ const c = document.getElementById('gallery-video-container'); if (c) c.innerHTML = ''; m.classList.add('hidden'); m.classList.remove('flex'); } } });
	return galleryModal;
}

						function openGalleryVideoModal(src){
							const modal = ensureGalleryModal();
							const container = document.getElementById('gallery-video-container');
							if (!container) return;
							container.innerHTML = '';
							if (/youtube\.com|youtu\.be|vimeo\.com/.test(src)){
								const iframe = document.createElement('iframe');
								let modalSrc = src;
							const ytMatch = src.match(/youtube\.com\/embed\/([A-Za-z0-9_-]+)/);
							if (ytMatch && ytMatch[1]){
								modalSrc = 'https://www.youtube.com/embed/' + ytMatch[1] + '?autoplay=1&controls=1&rel=0&modestbranding=1';
							} else {
								modalSrc = src + (src.indexOf('?') === -1 ? '?' : '&') + 'autoplay=1&controls=1&rel=0&modestbranding=1';
							}
							iframe.src = modalSrc;
								iframe.className = 'w-full h-full';
								iframe.setAttribute('frameborder','0');
								iframe.setAttribute('allow','autoplay; fullscreen; encrypted-media; picture-in-picture');
							iframe.setAttribute('allowfullscreen','');
								container.appendChild(iframe);
							} else {
								const video = document.createElement('video');
								video.controls = true; video.playsInline = true; video.className = 'w-full h-full bg-black';
								const s = document.createElement('source'); s.src = src; s.type = 'video/mp4';
								video.appendChild(s);
								container.appendChild(video);
								video.play().catch(()=>{});
							}
							modal.classList.remove('hidden'); modal.classList.add('flex');
						}
					})();
					</script>
