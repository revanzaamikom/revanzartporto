			// Interactive Zoom & Pan Logic State
			let zoomScale = 1;
			let panX = 0;
			let panY = 0;
			let isPanning = false;
			let startX = 0;
			let startY = 0;
			let transformRafId = 0;
			
			// Touch events pinch gesture memory
			let touchStartDist = 0;
			let touchStartScale = 1;
			let isPinching = false;

			function resetZoomAndPan() {
				zoomScale = 1;
				panX = 0;
				panY = 0;
				applyZoomTransform();
			}

			function clampPanToBounds(workspace, previewImg) {
				if (!workspace || !previewImg || zoomScale <= 1) {
					panX = 0;
					panY = 0;
					return;
				}

				const workspaceRect = workspace.getBoundingClientRect();
				const baseWidth = previewImg.clientWidth;
				const baseHeight = previewImg.clientHeight;
				if (!baseWidth || !baseHeight) return;

				const scaledWidth = baseWidth * zoomScale;
				const scaledHeight = baseHeight * zoomScale;
				const maxPanX = Math.max(0, (scaledWidth - workspaceRect.width) / 2);
				const maxPanY = Math.max(0, (scaledHeight - workspaceRect.height) / 2);

				panX = Math.max(-maxPanX, Math.min(maxPanX, panX));
				panY = Math.max(-maxPanY, Math.min(maxPanY, panY));
			}

			function applyZoomTransform() {
				const workspace = document.getElementById('cert-zoom-workspace');
				const previewImg = document.getElementById('cert-main-preview');
				if (!previewImg) return;

				clampPanToBounds(workspace, previewImg);

				if (transformRafId) {
					window.cancelAnimationFrame(transformRafId);
				}

				// Use requestAnimationFrame for ultra-smooth 60fps mobile transitions
				transformRafId = window.requestAnimationFrame(() => {
					previewImg.style.transform = `translate(${panX}px, ${panY}px) scale(${zoomScale})`;
					transformRafId = 0;
				});
			}

			// Helper to get distance between two touch points for pinching
			function getTouchDistance(e) {
				if (e.touches.length < 2) return 0;
				const x = e.touches[0].clientX - e.touches[1].clientX;
				const y = e.touches[0].clientY - e.touches[1].clientY;
				return Math.hypot(x, y);
			}

			// Setup Zoom & Pan Event Listeners (Mouse + Touch Screen / Touchpad)
			function setupZoomAndPan() {
				const workspace = document.getElementById('cert-zoom-workspace');
				const previewImg = document.getElementById('cert-main-preview');
				if (!workspace || !previewImg) return;
				if (workspace.dataset.zoomPanBound === '1') return;
				workspace.dataset.zoomPanBound = '1';
				workspace.style.touchAction = 'none';

				// Prevent default browser image drag behaviors
				workspace.addEventListener('dragstart', (e) => e.preventDefault());

				// 1. Wheel-to-Zoom (Desktop Mouse Wheel or Trackpad scrolls)
				workspace.addEventListener('wheel', (e) => {
					e.preventDefault();
					
					const zoomFactor = 0.15;
					let newScale = zoomScale;

					if (e.deltaY < 0) {
						// Zoom In
						newScale = Math.min(zoomScale + zoomFactor, 5);
					} else {
						// Zoom Out
						newScale = Math.max(zoomScale - zoomFactor, 1);
					}

					if (newScale === 1) {
						panX = 0;
						panY = 0;
					} else {
						// Zoom centering relative to mouse cursor
						const rect = workspace.getBoundingClientRect();
						const mouseX = e.clientX - rect.left - rect.width / 2;
						const mouseY = e.clientY - rect.top - rect.height / 2;
						
						const ratio = (newScale - zoomScale) / zoomScale;
						panX -= mouseX * ratio;
						panY -= mouseY * ratio;
					}

					zoomScale = newScale;
					applyZoomTransform();
				}, { passive: false });

				// 2. Desktop Mouse Click-to-Drag Pan (Pointer Events)
				workspace.addEventListener('pointerdown', (e) => {
					if (e.pointerType === 'touch') return; // Handled separately by TouchEvents below
					if (zoomScale <= 1) return; // Only pan when zoomed in
					e.preventDefault();
					isPanning = true;
					startX = e.clientX - panX;
					startY = e.clientY - panY;
					workspace.setPointerCapture(e.pointerId);
				});

				workspace.addEventListener('pointermove', (e) => {
					if (e.pointerType === 'touch') return;
					if (!isPanning) return;
					e.preventDefault();
					panX = e.clientX - startX;
					panY = e.clientY - startY;
					applyZoomTransform();
				});

				const stopPanning = (e) => {
					if (e.pointerType === 'touch') return;
					if (!isPanning) return;
					isPanning = false;
					try { workspace.releasePointerCapture(e.pointerId); } catch(err) {}
				};

				workspace.addEventListener('pointerup', stopPanning);
				workspace.addEventListener('pointercancel', stopPanning);
				workspace.addEventListener('pointerleave', stopPanning);

				// 3. Touch Screen Pinch-to-Zoom & Swipe-to-Pan (Mobile / Tablet / Touch laptops)
				workspace.addEventListener('touchstart', (e) => {
					if (e.touches.length === 1) {
						// Single finger Touch Pan init
						if (zoomScale > 1) {
							// Prevent parent page scrolling when zooming & dragging inside modal
							e.preventDefault();
							e.stopPropagation();
							isPanning = true;
							startX = e.touches[0].clientX - panX;
							startY = e.touches[0].clientY - panY;
						}
					} else if (e.touches.length === 2) {
						// Double finger Pinch Zoom init
						e.preventDefault();
						e.stopPropagation();
						isPinching = true;
						isPanning = false; // Disable panning during zoom
						touchStartDist = getTouchDistance(e);
						touchStartScale = zoomScale;
					}
				}, { passive: false });

				workspace.addEventListener('touchmove', (e) => {
					if (isPinching && e.touches.length === 2) {
						e.preventDefault(); // Stop entire page from zooming or bouncing
						e.stopPropagation();

						const dist = getTouchDistance(e);
						if (dist === 0 || touchStartDist === 0) return;

						const factor = dist / touchStartDist;
						let newScale = touchStartScale * factor;
						
						// Restrain zoom limits
						newScale = Math.max(1, Math.min(newScale, 5));

						if (newScale === 1) {
							panX = 0;
							panY = 0;
						} else {
							// Pinch center focal calculation
							const rect = workspace.getBoundingClientRect();
							const midX = (e.touches[0].clientX + e.touches[1].clientX) / 2 - rect.left - rect.width / 2;
							const midY = (e.touches[0].clientY + e.touches[1].clientY) / 2 - rect.top - rect.height / 2;
							
							const ratio = (newScale - zoomScale) / zoomScale;
							panX -= midX * ratio;
							panY -= midY * ratio;
						}

						zoomScale = newScale;
						applyZoomTransform();
					} else if (isPanning && e.touches.length === 1) {
						// Single finger Swipe to Pan
						e.preventDefault();
						e.stopPropagation();
						
						panX = e.touches[0].clientX - startX;
						panY = e.touches[0].clientY - startY;
						applyZoomTransform();
					}
				}, { passive: false });

				const stopTouchGestures = (e) => {
					if (e.touches.length === 1 && zoomScale > 1) {
						// Seamless transition from two-finger pinch to one-finger pan
						isPinching = false;
						isPanning = true;
						startX = e.touches[0].clientX - panX;
						startY = e.touches[0].clientY - panY;
						return;
					}

					if (e.touches.length < 2) isPinching = false;
					if (e.touches.length === 0) isPanning = false;
				};

				workspace.addEventListener('touchend', stopTouchGestures);
				workspace.addEventListener('touchcancel', stopTouchGestures);
			}

			// Helper to select and display a certificate in the vault
			function selectCertificate(element) {
				const imgPath = element.getAttribute('data-img');
				const titleText = element.getAttribute('data-title');
				
				const previewImg = document.getElementById('cert-main-preview');
				const previewTitle = document.getElementById('cert-main-title');
				
				if (previewImg && previewTitle && imgPath && titleText) {
					// Reset zoom before loading new image
					resetZoomAndPan();

					// Apply quick transition effect
					previewImg.style.opacity = '0';
					setTimeout(() => {
						previewImg.src = imgPath;
						previewImg.alt = titleText;
						previewTitle.textContent = titleText;
						previewImg.style.opacity = '1';
					}, 150);
				}
				
				// Toggle active classes on items
				document.querySelectorAll('.cert-item').forEach(item => {
					item.classList.remove('bg-white/5', 'active-cert');
					item.classList.add('bg-transparent');
					const textDiv = item.querySelector('div');
					if (textDiv) {
						textDiv.classList.remove('text-white');
						textDiv.classList.add('text-zinc-400');
					}
				});
				
				element.classList.remove('bg-transparent');
				element.classList.add('bg-white/5', 'active-cert');
				const textDiv = element.querySelector('div');
				if (textDiv) {
					textDiv.classList.remove('text-zinc-400');
					textDiv.classList.add('text-white');
				}
			}

			// Listen to certificate selection clicks
			document.addEventListener('click', function(e) {
				const certBtn = e.target.closest('.cert-item');
				if (certBtn) {
					e.preventDefault();
					selectCertificate(certBtn);
				}
			});
			
			// Setup zoom interactions once DOM loads or modal opens
			document.addEventListener('DOMContentLoaded', () => {
				setupZoomAndPan();
			});
			
			// Backup hook inside page load/completes
			setTimeout(setupZoomAndPan, 500);
			window.addEventListener('load', setupZoomAndPan);
	
			// Helper to create and manage dynamic flipbook modal
			let magModalEl = null;
			function ensureMagModal() {
				if (magModalEl) return magModalEl;
				magModalEl = document.createElement('div');
				magModalEl.id = 'mag-lightbox-modal';
				magModalEl.className = 'fixed inset-0 z-[100] w-full h-[100dvh] md:h-screen hidden items-center justify-center bg-black/90';
				magModalEl.innerHTML = `
					<div class="relative w-full h-full max-w-6xl max-h-[90vh] bg-zinc-950 rounded-2xl overflow-hidden border border-white/10 flex flex-col">
						<div class="p-4 bg-zinc-900 border-b border-white/5 flex justify-between items-center">
							<h3 class="font-bold text-white tracking-wide">GTR EVOLUTION - Interactive Magazine Showcase</h3>
							<button id="mag-lightbox-close" class="bg-white/10 hover:bg-white/20 text-white p-2 rounded-full w-8 h-8 flex items-center justify-center font-bold transition-colors">✕</button>
						</div>
						<div id="mag-iframe-container" class="w-full h-full max-h-[85vh] md:max-h-[90vh] relative overflow-hidden rounded-xl bg-black">
							<!-- iframe dynamically inserted on demand -->
						</div>
					</div>
				`;
				document.body.appendChild(magModalEl);

				// Close handlers
				const closeBtn = magModalEl.querySelector('#mag-lightbox-close');
				closeBtn?.addEventListener('click', closeMagModal);
				magModalEl.addEventListener('click', (e) => {
					if (e.target === magModalEl) closeMagModal();
				});

				return magModalEl;
			}

			function openMagModal(url) {
				let safeUrl = '';
				try {
					const parsed = new URL(url, window.location.origin);
					const allowedHost = /(^|\.)heyzine\.com$/i.test(parsed.hostname);
					if (parsed.protocol === 'https:' && allowedHost) {
						safeUrl = parsed.toString();
					}
				} catch (e) {}
				if (!safeUrl) return;

				const modal = ensureMagModal();
				const container = modal.querySelector('#mag-iframe-container');
				if (container) {
					container.innerHTML = '';
					const iframe = document.createElement('iframe');
					iframe.src = safeUrl;
					iframe.className = 'w-full h-full border-0';
					iframe.style.minHeight = '500px';
					iframe.setAttribute('allowfullscreen', 'true');
					iframe.setAttribute('allow', 'autoplay; fullscreen');
					iframe.setAttribute('loading', 'lazy');
					container.appendChild(iframe);
				}
				modal.classList.remove('hidden');
				modal.classList.add('flex');
			}

			function closeMagModal() {
				const modal = document.getElementById('mag-lightbox-modal');
				if (!modal) return;
				const container = modal.querySelector('#mag-iframe-container');
				if (container) container.innerHTML = ''; // Destroy iframe immediately to release RAM
				modal.classList.add('hidden');
				modal.classList.remove('flex');
			}

			// Global event listeners (scoped, non-destructive)
			document.addEventListener('click', function(e){
				const lb = e.target.closest('[data-lightbox]');
				if (lb){
					e.preventDefault();
					const src = lb.dataset.lightbox || lb.dataset.full || lb.src || lb.getAttribute('src');
					if (src) openLightbox(src);
					return;
				}
				const magBtn = e.target.closest('[data-open-magazine]');
				if (magBtn) {
					e.preventDefault();
					const url = magBtn.getAttribute('data-open-magazine');
					if (url) openMagModal(url);
					return;
				}
				if (e.target && e.target.id === 'lightbox-close') { closeLightbox(); return; }
				if (e.target && e.target.id === 'open-cert-vault'){ e.preventDefault(); openCertModal(); return; }
				if (e.target && e.target.id === 'close-cert-modal') { e.preventDefault(); closeCertModal(); return; }
				// click on backdrop to close modal if clicked directly on overlay
				if (e.target && e.target.id === 'cert-modal') { closeCertModal(); }
			});
	
			document.addEventListener('keydown', function(e){
				if (e.key === 'Escape') { closeLightbox(); closeCertModal(); closeMagModal(); }
			});
	
		})();
			</script>


	</main>
</Layout>
