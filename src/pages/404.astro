---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Halaman Tidak Ditemukan">
	<main class="min-h-screen flex items-center justify-center px-6">
		<div class="text-center">
			<h1 class="text-6xl md:text-9xl font-black tracking-tighter text-white">404</h1>
			<p class="mt-4 text-lg md:text-xl text-textMuted">Halaman tidak ditemukan</p>
			<a href="/" class="mt-8 inline-flex items-center gap-2 text-primary hover:text-white transition-colors">
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
				Kembali ke Beranda
			</a>
		</div>
	</main>
</Layout>