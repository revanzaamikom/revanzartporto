---
import GradientWaves from './GradientWaves.jsx';
import nutriverseVideo from '../video/nutriverse.mp4';
import andimediaVideo from '../video/andimedia.mp4';
import nexumVideo from '../video/nexum.mp4';
import pelunasanVideo from '../video/pelunasan.mp4';

const projects = [
	{
		id: "project-1",
		title: "Nutriverse Motion",
		category: "",
		videoUrl: nutriverseVideo,
		spanSize: "md:col-span-2 h-[350px] md:h-[600px]"
	},

	{
		id: "project-2",
		title: "Cyberpunk VFX Reel",
		category: "VFX",
		videoUrl: "https://assets.mixkit.co/videos/preview/mixkit-lens-flares-of-a-camera-in-close-up-34440-large.mp4",
		spanSize: "md:col-span-1 h-[288px] md:h-[600px] flex flex-col justify-end"
	},

	{
		id: "project-3",
		title: "Company Profile Andi Media Digital",
		category: "",
		videoUrl: andimediaVideo,
		spanSize: "md:col-span-1 h-[288px]"
	},

	{
		id: "project-4",
		title: "Nexum VFX Short Movie",
		category: "",
		videoUrl: nexumVideo,
		spanSize: "md:col-span-1 h-[288px]"
	},

	{
		id: "project-5",
		title: "Indie Short Movie - pelunasan sunyi",
		category: "",
		videoUrl: pelunasanVideo,
		spanSize: "md:col-span-1 h-[288px]"
	}
];
---
<section id="work" class="px-6 md:px-24 py-24 bg-[#050505] relative overflow-hidden">
	<!-- WebGL Animated Background -->
	<GradientWaves 
		client:visible 
		horizonColor="#050B14" 
		waveColor="#0055ff" 
		crestColor="#00ffff" 
		speed={0.3} 
		brightness={0.8} 
		opacity={0.6} 
		mouseInteraction={true} 
		className="absolute inset-0 z-0 pointer-events-none w-full h-full"
	/>

	<div class="max-w-7xl mx-auto relative z-10">
		<div class="mb-16 text-left">
			<h2 class="reveal-heading text-5xl font-extrabold tracking-tight text-white mb-4">
				Recent work
			</h2>
			<p class="reveal-heading text-lg text-gray-400 max-w-2xl">
				A few pieces from the reel. Click any of them to watch with sound.
			</p>
		</div>

		<!-- Bento Grid -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			{projects.map((project) => (
				<div 
					class={`reveal-card project-card group relative overflow-hidden rounded-3xl bg-black/40 backdrop-blur-md border border-white/10 cursor-pointer transform hover:scale-[1.02] hover:border-cyan-400/30 transition-all duration-500 shadow-2xl hover:shadow-[0_0_40px_rgba(0,255,255,0.12)] flex flex-col justify-end ${project.spanSize}`}
					data-video={project.videoUrl}
					data-title={project.title}
					data-category={project.category}
				>
					<!-- Video Autoplay Preview -->
					<div class="absolute inset-0 w-full h-full overflow-hidden">
						<video 
							src={project.videoUrl} 
							autoPlay 
							muted 
							loop 
							playsInline 
							class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-all duration-700 scale-100 group-hover:scale-[1.05]"
						/>
						<!-- Dark overlay for superior text contrast -->
						<div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent opacity-85 group-hover:opacity-75 transition-opacity duration-500"></div>
					</div>

					<!-- Play Button Overlay on Hover -->
					{!["project-1", "project-3", "project-4", "project-5"].includes(project.id) && (
						<div class="absolute top-6 right-6 w-12 h-12 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 shadow-lg">
							<svg class="w-5 h-5 text-cyan-400 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
								<path d="M8 5v14l11-7z" />
							</svg>
						</div>
					)}

					<!-- Content Info -->
					<div class="relative z-10 p-8 flex flex-col justify-end h-full">
						<div>
							{project.category && (
								<span class="inline-block px-3 py-1 bg-white/10 backdrop-blur-md border border-white/10 text-xs font-semibold rounded-full text-cyan-400 uppercase tracking-widest">
									{project.category}
								</span>
							)}
							<h3 class="text-xl md:text-3xl font-bold text-white mt-3 group-hover:text-cyan-350 transition-colors duration-300">
								{project.title}
							</h3>
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<!-- Beautiful Cinematic Lightbox Modal -->
<div id="video-lightbox" class="fixed inset-0 z-50 flex items-center justify-center bg-black/95 backdrop-blur-2xl opacity-0 pointer-events-none transition-all duration-300 px-4">
	<button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-cyan-400 transition-colors p-3 bg-white/5 rounded-full border border-white/10 hover:bg-white/10 z-50 shadow-2xl">
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6">
			<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
		</svg>
	</button>
	<div class="max-w-5xl w-full flex flex-col justify-center items-center gap-6">
		<div class="relative w-full aspect-video rounded-3xl overflow-hidden border border-white/15 bg-black shadow-2xl shadow-cyan-500/5">
			<video id="lightbox-video" class="w-full h-full object-cover" controls playsinline></video>
		</div>
		<div class="text-left w-full max-w-4xl px-2">
			<span id="lightbox-category" class="inline-block px-3 py-1 bg-cyan-400/10 border border-cyan-400/20 text-xs font-semibold rounded-full text-cyan-400 uppercase tracking-widest">Category</span>
			<h3 id="lightbox-title" class="text-2xl md:text-4xl font-extrabold text-white mt-3 leading-tight">Project Title</h3>
		</div>
	</div>
</div>

<script>
	const cards = document.querySelectorAll('.project-card');
	const lightbox = document.getElementById('video-lightbox');
	const lightboxVideo = document.getElementById('lightbox-video') as HTMLVideoElement | null;
	const lightboxClose = document.getElementById('lightbox-close');
	const lightboxCategory = document.getElementById('lightbox-category');
	const lightboxTitle = document.getElementById('lightbox-title');

	cards.forEach(card => {
		card.addEventListener('click', () => {
			const videoUrl = card.getAttribute('data-video');
			const title = card.getAttribute('data-title');
			const category = card.getAttribute('data-category');

			if (lightbox && lightboxVideo && lightboxTitle && lightboxCategory && videoUrl) {
				lightboxVideo.src = videoUrl;
				lightboxTitle.textContent = title || '';
				
				if (category) {
					lightboxCategory.textContent = category;
					lightboxCategory.style.display = 'inline-block';
				} else {
					lightboxCategory.textContent = '';
					lightboxCategory.style.display = 'none';
				}
				
				// Open lightbox with class changes
				lightbox.classList.remove('opacity-0', 'pointer-events-none');
				lightboxVideo.play().catch(err => console.log("Auto-play blocked inside lightbox:", err));
			}
		});
	});

	const closeLightbox = () => {
		if (lightbox && lightboxVideo) {
			lightboxVideo.pause();
			lightboxVideo.src = '';
			lightbox.classList.add('opacity-0', 'pointer-events-none');
		}
	};

	if (lightboxClose) {
		lightboxClose.addEventListener('click', closeLightbox);
	}

	if (lightbox) {
		lightbox.addEventListener('click', (e) => {
			if (e.target === lightbox) {
				closeLightbox();
			}
		});
	}

	// Support ESC key to close
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			closeLightbox();
		}
	});
</script>
