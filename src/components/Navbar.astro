---
---
<nav class="fixed top-5 left-1/2 -translate-x-1/2 z-50">
	<div class="bg-neutral-900/70 backdrop-blur-xl border border-white/10 shadow-2xl shadow-black/50 rounded-full px-6 py-2.5 md:px-8 md:py-3 flex items-center gap-8 md:gap-12">
		<!-- Left: Logo -->
		<a href="/" class="text-lg font-bold tracking-wider hover:opacity-80 transition-opacity">
			REVANZART
		</a>

		<!-- Right: Nav links -->
		<div class="flex items-center gap-6 md:gap-8 text-sm font-medium">
			<a href="/#work" class="text-textMuted hover:text-white transition-all relative group">
				Work
				<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-white transition-all group-hover:w-full"></span>
			</a>
			<a href="/#gallery" class="text-textMuted hover:text-white transition-all relative group" data-smooth-scroll>
				Gallery
				<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-white transition-all group-hover:w-full"></span>
			</a>
			<a href="mailto:contact@example.com" class="text-textMuted hover:text-white transition-all relative group">
				Contact
				<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-white transition-all group-hover:w-full"></span>
			</a>
		</div>
	</div>
</nav>
<script>
// Smooth scroll for nav links that target anchors on the same page
document.addEventListener('click', function(e){
	const a = e.target.closest && e.target.closest('a[data-smooth-scroll]');
	if (!a) return;
	// Only handle same-origin same-path anchors; fall back to default behavior otherwise	if (a.pathname !== location.pathname || a.hostname !== location.hostname){ return; }
	e.preventDefault();
	const hash = a.getAttribute('href') || '';	const id = hash.split('#')[1];	if (!id) return; const target = document.getElementById(id);	if (target){ target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
	else { location.href = hash; }
});
</script>
