      <a href="/" class="inline-flex items-center leading-none text-sm md:text-base font-bold tracking-wider hover:opacity-80 transition-opacity px-4 md:px-6 border-x border-white/10">
        REVANZART
      </a>

      <a href="/#gallery" class="inline-flex items-center leading-none text-sm font-medium text-textMuted hover:text-white transition-all relative group" data-smooth-scroll>
