---
// Komponen ini hanya berisi <script> client-side.
// ScrollReveal diimpor di dalam <script> sehingga hanya dieksekusi di browser,
// menghindari error "window is not defined" saat build/SSR.
---

<script type="module">
	// Robust Scroll reveal initializer with media control: prefers IntersectionObserver and postMessage for YouTube
	const initScrollReveal = async () => {
		// Wider set of selectors to cover main sections, gallery, panels and common list/grid items
			const targetSelector = [
				'.reveal-heading',
				'.reveal-card',
				'.hero-text',
				'.reveal-section',
				'.reveal-list-item',
				'#gallery',
				'#gallery *',
				'[data-panel-content]',
				'[data-category-panel] .rounded-lg',
				'[data-marketing-panel] .rounded-lg',
				'[data-publication-panel] .rounded-lg',
				'.panel-content .rounded-lg',
				'.publication-panels .rounded-lg'
			].join(', ');
			const targets = Array.from(document.querySelectorAll(targetSelector));
			// continue even if some selectors are missing
			// (no early return)

		// Apply initial CSS state so fallback animations have something to work with
		targets.forEach(el => el.classList.add('sr-init'));

		// Prepare staggered delays for known group selectors (fallback)
		const staggerGroups = ['.reveal-card', '.reveal-list-item'];
		staggerGroups.forEach(sel => {
			const nodes = Array.from(document.querySelectorAll(sel));
			nodes.forEach((n, i) => {
				// only set if not explicitly set already
				if (!n.style.transitionDelay) n.style.transitionDelay = `${(i * 0.12).toFixed(2)}s`;
			});
		});

		// Helpers
		function isPanelVisible(el) {
			if (!el) return true;
			const panel = el.closest('[data-panel-content], [data-marketing-panel], [data-publication-panel]');
			if (!panel) return true;
			if (panel.classList && panel.classList.contains('hidden')) return false;
			const cs = getComputedStyle(panel);
			return cs && cs.display !== 'none' && cs.visibility !== 'hidden' && cs.opacity !== '0';
		}

		function isYouTubeSrc(src) {
			return /youtube\.com|youtu\.be/.test(src || '');
		}

		function sendYouTubeCommand(iframe, func) {
			try {
				if (!iframe || !iframe.contentWindow) return;
				const msg = JSON.stringify({ event: 'command', func: func, args: [] });
				iframe.contentWindow.postMessage(msg, '*');
			} catch (e) {}
		}

		function ensureEnableJSAPI(iframe) {
			try {
				const current = iframe.dataset.origSrc || iframe.src || '';
				if (!current) return;
				if (!isYouTubeSrc(current)) { iframe.dataset.origSrc = current; return; }
				const u = new URL(current, location.href);
				if (!u.searchParams.get('enablejsapi')) {
					u.searchParams.set('enablejsapi', '1');
					iframe.dataset.origSrc = current;
					iframe.src = u.toString(); // one-time reload to enable JS API
				} else {
					iframe.dataset.origSrc = current;
				}
			} catch (e) {}
		}


		// Allow overriding media control via global helpers (defined in page scope)
		let playMediaInFn = null;
		let pauseMediaInFn = null;
		let prepareMediaStoppingFn = null;
		if (window && window.mediaHelpers) {
			playMediaInFn = window.mediaHelpers.playMediaIn;
			pauseMediaInFn = window.mediaHelpers.pauseMediaIn;
			prepareMediaStoppingFn = window.mediaHelpers.prepareMediaStopping;
		} else {
			prepareMediaStoppingFn = function(scope) {
				// Store original iframe src and ensure YouTube iframes have enablejsapi=1
				scope.querySelectorAll('iframe').forEach(iframe => {
					try {
						if (!iframe.dataset.origSrc) iframe.dataset.origSrc = iframe.src || '';
						if (isYouTubeSrc(iframe.dataset.origSrc || iframe.src)) {
							ensureEnableJSAPI(iframe);
						} else {
							// blank non-YouTube iframe src to prevent autoplay until reveal
							iframe.src = '';
						}
					} catch (e) {}
				});

				// pause native videos until reveal
				scope.querySelectorAll('video').forEach(video => {
					try { video.pause(); } catch (e) {}
				});
			};

			playMediaInFn = function(el) {
				if (!el) return;
				el.querySelectorAll('video').forEach(video => {
					if (isPanelVisible(video)) { try { video.play().catch(()=>{}); } catch(e){} }
				});
				el.querySelectorAll('iframe').forEach(iframe => {
					try {
						if (!isPanelVisible(iframe)) return;
						const src = iframe.dataset.origSrc || iframe.src || '';
						if (isYouTubeSrc(src)) {
							// use postMessage API to play without reloading
							sendYouTubeCommand(iframe, 'playVideo');
						} else if (iframe.dataset.origSrc) {
							iframe.src = iframe.dataset.origSrc;
						}
					} catch (e) {}
				});
			};

			pauseMediaInFn = function(el) {
				if (!el) return;
				el.querySelectorAll('video').forEach(video => {
					try { video.pause(); } catch (e) {}
				});
				el.querySelectorAll('iframe').forEach(iframe => {
					try {
						const src = iframe.dataset.origSrc || iframe.src || '';
						if (isYouTubeSrc(src)) {
							// send pause command via postMessage
							sendYouTubeCommand(iframe, 'pauseVideo');
						} else {
							iframe.src = '';
						}
					} catch (e) {}
				});
			};
		}

		// Use the functions (local or global)
		const prepareMediaStopping = (scope) => { try{ prepareMediaStoppingFn && prepareMediaStoppingFn(scope); } catch(e){} };
		const playMediaIn = (el) => { try{ playMediaInFn && playMediaInFn(el); } catch(e){} };
		const pauseMediaIn = (el) => { try{ pauseMediaInFn && pauseMediaInFn(el); } catch(e){} };

		// Initialize media stop for entire document targets so nothing auto-plays before reveal
		targets.forEach(t => prepareMediaStopping(t));

		// IntersectionObserver reveal that toggles on enter/exit and controls media
		let io = null;
		const observerOptions = { threshold: 0.05 };
		io = new IntersectionObserver((entries) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('sr-revealed');
					playMediaIn(entry.target);
				} else {
					entry.target.classList.remove('sr-revealed');
					pauseMediaIn(entry.target);
				}
			});
		}, observerOptions);

		// Observe all targets (safe if empty)
		targets.forEach(el => {
			try { io.observe(el); } catch (e) {}
		});

		// Manual refresh function for panels that become visible after display:none
		function isElementVisibleInViewport(el) {
			const rect = el.getBoundingClientRect();
			const vh = window.innerHeight || document.documentElement.clientHeight;
			// Consider visible if it crosses a small threshold of viewport
			return rect.top < vh * 0.95 && rect.bottom > vh * 0.05 && rect.width > 0 && rect.height > 0;
		}

		function refreshReveal() {
			targets.forEach(el => {
				try {
					if (isElementVisibleInViewport(el)) {
						el.classList.add('sr-revealed');
						playMediaIn(el);
					} else {
						// If it's not currently visible, let IO handle it; but remove only if it's truly out
						if (!isElementVisibleInViewport(el)) {
							el.classList.remove('sr-revealed');
							pauseMediaIn(el);
						}
					}
				} catch (e) {}
			});
		}

		// Expose refresh globally so tab switches can call it
		window.refreshScrollReveal = refreshReveal;

		// Run initial refresh after a short delay to catch elements rendered later
		setTimeout(refreshReveal, 300);
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initScrollReveal);
	} else {
		// run next frame so any client islands have a chance to attach
		requestAnimationFrame(initScrollReveal);
	}
</script>

<style is:global>
	/* Fallback CSS animations when ScrollReveal isn't available. */
	.sr-init {
		opacity: 0;
		transform: translateY(40px) scale(0.95);
		transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1), transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.sr-revealed {
		opacity: 1 !important;
		transform: translateY(0) scale(1) !important;
	}
</style>