const quickLinks = [
	{ label: 'About', href: '/#what-i-do' },
	{ label: 'Recent Work', href: '/#work' },
	{ label: 'Gallery', href: '/#gallery' },
	{ label: 'Certificate', href: '/#certificates' }
];
---

<footer class="relative z-20 mt-24 border-t border-white/5 bg-background">
	<!-- CTA Section -->
	<section class="relative overflow-hidden py-24 md:py-32">
		<!-- Subtle glow effect -->
		<div class="absolute inset-0 pointer-events-none" aria-hidden="true">
			<div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-cyan-500/5 blur-[120px] rounded-full"></div>
		</div>

		<div class="relative max-w-7xl mx-auto px-6 md:px-24 text-center">
			<p class="text-sm text-textMuted uppercase tracking-[0.3em] mb-6 reveal-heading">Let's Collaborate</p>
			<h2 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.05] reveal-heading">
				Let's Create Something<br class="hidden md:block" />
				<span class="text-cyan-500 drop-shadow-[0_0_12px_rgba(6,182,212,0.5)]">Amazing</span>
			</h2>
			<p class="text-textMuted mt-6 max-w-xl mx-auto text-base md:text-lg reveal-heading">
				Punya proyek video, motion design, atau desain grafis? Mari wujudkan ide Anda menjadi karya yang berkesan.
			</p>
			<div class="mt-10 reveal-heading flex justify-center">
				<a 
					href="mailto:importantrevanza@gmail.com" 
					class="group relative inline-flex items-center gap-2.5 px-8 py-4 text-sm font-semibold rounded-full tracking-wide bg-cyan-500 text-black hover:bg-cyan-400 transition-all duration-300 shadow-[0_0_20px_rgba(6,182,212,0.35)] hover:shadow-[0_0_30px_rgba(6,182,212,0.55)] hover:-translate-y-0.5 overflow-hidden"
				>
					<!-- Inner pulse glow animation -->
					<span class="absolute inset-0 w-full h-full bg-white/20 transform -skew-x-12 -translate-x-full group-hover:animate-shine"></span>
					<svg class="w-4 h-4 transition-transform duration-300 group-hover:rotate-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
					</svg>
					<span class="relative z-10">Hubungi Saya</span>
				</a>
			</div>
		</div>
	</section>

	<!-- Main Footer Content -->
	<div class="border-t border-white/5">
		<div class="max-w-7xl mx-auto px-6 md:px-24 py-16">
			<div class="grid grid-cols-1 md:grid-cols-12 gap-12">
				<!-- Brand Column -->
				<div class="md:col-span-5">
					<a href="/" class="inline-block text-2xl font-extrabold tracking-wider hover:opacity-80 transition-opacity">
						REVANZART
					</a>
					<p class="text-textMuted mt-4 text-sm leading-relaxed max-w-sm">
						Video Editor & Motion Designer — Mahasiswa Teknologi Informasi. Menghadirkan karya visual yang sinematik, dinamis, dan berkesan.
					</p>
					<!-- Social Icons -->
					<div class="flex items-center gap-3.5 mt-6">
						{
							socialLinks.map((social) => (
								<a
									href={social.href}
									target={social.href.startsWith('mailto:') ? undefined : '_blank'}
									rel={social.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
									aria-label={social.name}
									class="w-10 h-10 flex items-center justify-center rounded-full bg-surface border border-white/5 text-textMuted hover:text-white hover:border-cyan-400/40 hover:bg-zinc-900/50 hover:-translate-y-1 hover:shadow-[0_0_15px_rgba(6,182,212,0.15)] transition-all duration-300 ease-out"
									set:html={social.icon}
								/>
							))
						}
					</div>
				</div>

				<!-- Quick Links Column -->
				<div class="md:col-span-3">
					<h3 class="text-sm text-textMuted uppercase tracking-widest font-semibold">Navigasi</h3>
					<ul class="mt-5 space-y-3">
						{
							quickLinks.map((link) => (
								<li>
									<a
										href={link.href}
										class="group inline-flex items-center text-sm text-zinc-400 hover:text-white hover:translate-x-1.5 transition-all duration-300 relative"
									>
										<span class="absolute -left-4 w-0 h-px bg-cyan-500 transition-all duration-300 group-hover:w-3"></span>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</div>

				<!-- Contact Column -->
				<div class="md:col-span-4">
					<h3 class="text-sm text-textMuted uppercase tracking-widest font-semibold">Kontak</h3>
					<ul class="mt-5 space-y-3 text-sm">
						<li>
							<a href="mailto:importantrevanza@gmail.com" class="group text-zinc-400 hover:text-white hover:translate-x-1 transition-all duration-300 inline-flex items-center gap-2.5">
								<svg class="w-4 h-4 flex-none text-zinc-500 group-hover:text-cyan-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
								importantrevanza@gmail.com
							</a>
						</li>
						<li>
							<a href="https://instagram.com/revanzarh" target="_blank" rel="noopener noreferrer" class="group text-zinc-400 hover:text-white hover:translate-x-1 transition-all duration-300 inline-flex items-center gap-2.5">
								<svg class="w-4 h-4 flex-none text-zinc-500 group-hover:text-cyan-400 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
								@revanzarh
							</a>
						</li>
						<li>
							<a href="https://www.youtube.com/@Revanzarh/videos" target="_blank" rel="noopener noreferrer" class="group text-zinc-400 hover:text-white hover:translate-x-1 transition-all duration-300 inline-flex items-center gap-2.5">
								<svg class="w-4 h-4 flex-none text-zinc-500 group-hover:text-cyan-400 transition-colors" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
								YouTube
							</a>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>

	<!-- Copyright Bar -->
	<div class="border-t border-white/5">
		<div class="max-w-7xl mx-auto px-6 md:px-24 py-6 flex flex-col sm:flex-row items-center justify-between gap-3">
			<p class="text-xs text-zinc-500">
				© {currentYear} Muhamad Revanza Rafif Hamdani. All rights reserved.
			</p>
			<p class="text-xs text-zinc-600">
				Dibangun dengan Astro & Tailwind CSS
			</p>
		</div>
	</div>
</footer>